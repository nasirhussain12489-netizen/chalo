{
  "entities": {
    "AdminSession": {
      "title": "AdminSession",
      "description": "Tracks active authenticated administrator sessions in Firebase Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "Administrator Gmail" },
        "name": { "type": "string", "description": "Administrator display name" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "CLASS_ADMIN"], "description": "Administrator role" },
        "assignedClass": { "type": "string", "description": "Assigned class U1-U6 or null for Super Admin" },
        "lastActiveAt": { "type": "string", "format": "date-time", "description": "Timestamp of last activity" }
      },
      "required": ["uid", "email", "name", "role"]
    }
  },
  "firestore": {
    "/adminSessions/{uid}": {
      "schema": { "$ref": "#/entities/AdminSession" },
      "description": "Stores administrator session metadata keyed by Firebase Auth UID."
    }
  }
}
